  "info": {
    "_postman_id": "c23f0d8d-4cce-46e9-b86e-6554657b1a4c",
    "name": "TimezoneDB Conversion API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "TimezoneDB is a REST API providing timezone information for cities and coordinates worldwide. It supports looking up local time, GMT offset, and daylight saving time (DST) status by timezone name, geographic coordinates (latitude/longitude), city name, or IP address. The service also supports converting times between timezones and listing all 400+ supported timezones across 240+ countries. Responses are available in JSON or XML formats.\n\n\nContact Support:\n Name: TimezoneDB Support",
      "type": "text/plain"
    }
  }
