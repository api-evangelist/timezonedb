        {
          "id": "fe697ce3-e01c-428c-9793-e18ccf1b6f1f",
          "name": "Get Time Zone",
          "request": {
            "name": "Get Time Zone",
            "description": {
              "content": "Retrieve local time, GMT offset, and DST information for a location. Lookup can be performed by timezone name or abbreviation, geographic coordinates (lat/lng), city name (with country), or IP address.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "get-time-zone"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "key",
                  "value": "<string>",
                  "description": "(Required) Your unique API key obtained after registering an account."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "xml",
                  "description": "Response format. Defaults to xml."
                },
                {
                  "disabled": false,
                  "key": "callback",
                  "value": "<string>",
                  "description": "JavaScript JSONP callback function name."
                },
                {
                  "disabled": false,
                  "key": "fields",
                  "value": "<string>",
                  "description": "Comma-separated list of field names to include in the response."
                },
                {
                  "disabled": false,
                  "key": "by",
                  "value": "<string>",
                  "description": "(Required) The lookup method to use. One of: - zone: Look up by timezone name or abbreviation - position: Look up by latitude/longitude coordinates - city: Look up by city name and country code - ip: Look up by IP address\n"
                },
                {
                  "disabled": false,
                  "key": "zone",
                  "value": "<string>",
                  "description": "Time zone name or abbreviation. Required when by=zone. Example: \"America/Chicago\" or \"CDT\".\n"
                },
                {
                  "disabled": false,
                  "key": "lat",
                  "value": "<float>",
                  "description": "Latitude coordinate in decimal degrees. Required when by=position. Range: -90 to 90.\n"
                },
                {
                  "disabled": false,
                  "key": "lng",
                  "value": "<float>",
                  "description": "Longitude coordinate in decimal degrees. Required when by=position. Range: -180 to 180.\n"
                },
                {
                  "disabled": false,
                  "key": "country",
                  "value": "<string>",
                  "description": "ISO 3166-1 alpha-2 country code. Required when by=city.\n"
                },
                {
                  "disabled": false,
                  "key": "region",
                  "value": "<string>",
                  "description": "US region/state code for additional filtering when by=city.\n"
                },
                {
                  "disabled": false,
                  "key": "city",
                  "value": "<string>",
                  "description": "City name. Required when by=city. Supports wildcard (*) pattern matching.\n"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Page number for paginated results when multiple cities match."
                },
                {
                  "disabled": false,
                  "key": "time",
                  "value": "<long>",
                  "description": "Unix timestamp in UTC to retrieve timezone information for a specific point in time. Defaults to current UTC time.\n"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
