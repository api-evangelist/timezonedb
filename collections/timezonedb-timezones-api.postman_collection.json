          "name": "List Time Zones",
          "request": {
            "name": "List Time Zones",
            "description": {
              "content": "List out all available time zones supported by TimezoneDB. Optionally filter by country code or timezone name pattern. Supports field selection to customize the response payload.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "list-time-zone"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "key",
                  "value": "<string>",
                  "description": "(Required) Your unique API key obtained after registering an account."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "xml",
                  "description": "Response format. Defaults to xml."
                },
                {
                  "disabled": false,
                  "key": "callback",
                  "value": "<string>",
                  "description": "JavaScript JSONP callback function name."
                },
                {
                  "disabled": false,
                  "key": "fields",
                  "value": "<string>",
                  "description": "Comma-separated list of field names to include in the response. Available fields: countryCode, countryName, zoneName, gmtOffset, dst, timestamp. Defaults to: countryCode, countryName, zoneName, gmtOffset, timestamp.\n"
                },
                {
                  "disabled": false,
                  "key": "country",
                  "value": "<string>",
                  "description": "ISO 3166-1 alpha-2 country code to filter results by nation."
                },
                {
                  "disabled": false,
                  "key": "zone",
                  "value": "<string>",
                  "description": "Timezone name to filter results. Supports asterisk (*) wildcard. Example: \"America/*\" returns all American timezones.\n"
                }
              ],
              "variable": []
            },
            "header": [
